{
  "name": "desktop",
  "version": "0.0.2",
  "private": true,
  "description": "A design canvas that agents edit",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "postinstall": "install-electron",
    "build": "vp pack",
    "dev": "vp pack && electron . --dev",
    "start": "electron .",
    "package": "node scripts/stage-server.mjs && electron-builder --publish never",
    "test": "vp test"
  },
  "devDependencies": {
    "@electron/osx-sign": "catalog:",
    "@types/node": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-updater": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
