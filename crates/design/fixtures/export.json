    {
      "name": "script and style text can't close their tag early",
      "root": "box",
      "nodes": [
        {
          "id": "box",
          "parent": null,
          "index": "V",
          "type": "element",
          "tag": "div",
          "name": null,
          "text": null,
          "x": 0.0,
          "y": 0.0,
          "styles": {},
          "attrs": {}
        },
        {
          "id": "st",
          "parent": "box",
          "index": "F",
          "type": "element",
          "tag": "style",
          "name": null,
          "text": null,
          "x": null,
          "y": null,
          "styles": {},
          "attrs": {}
        },
        {
          "id": "css",
          "parent": "st",
          "index": "V",
          "type": "text",
          "name": null,
          "text": ".a::after{content:\"</STYLE>\"}",
          "x": null,
          "y": null,
          "styles": {},
          "attrs": {}
        },
        {
          "id": "sc",
          "parent": "box",
          "index": "V",
          "type": "element",
          "tag": "script",
          "name": null,
          "text": null,
          "x": null,
          "y": null,
          "styles": {},
          "attrs": {}
        },
        {
          "id": "js",
          "parent": "sc",
          "index": "V",
          "type": "text",
          "name": null,
          "text": "console.log('</script>')",
          "x": null,
          "y": null,
          "styles": {},
          "attrs": {}
        }
      ],
      "expect": "<div><style>.a::after{content:\"<\\/STYLE>\"}</style><script>console.log('<\\/script>')</script></div>"
    },
    {
      "name": "svg keeps its tags and attributes",
      "root": "svg",
      "nodes": [
        {
          "id": "svg",
          "parent": null,
          "index": "V",
          "type": "element",
          "tag": "svg",
          "name": null,
          "text": null,
          "x": 0.0,
          "y": 0.0,
          "styles": {},
          "attrs": {
            "viewBox": "0 0 10 10",
            "width": "10"
          }
        },
        {
          "id": "path",
          "parent": "svg",
          "index": "V",
          "type": "element",
          "tag": "path",
          "name": null,
          "text": null,
          "x": null,
          "y": null,
          "styles": {},
          "attrs": {
            "d": "M0 0L10 10",
            "stroke": "red"
